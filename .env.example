# ---- ChessMentor backend configuration ----
# Copy this file to server/.env and fill in the values for the provider you want.
#
# The coach supports two providers. Selection order (first match wins):
#   1. COACH_PROVIDER   (explicit: "anthropic" | "local")
#   2. ANTHROPIC_API_KEY present  -> "anthropic"
#   3. OPENAI_BASE_URL present    -> "local"
#   4. otherwise the coach is offline (the game still works)

# Port the Express backend listens on (the Vite dev server proxies /api here).
PORT=3001

# =========================================================================
# Option A — Anthropic Claude (production path)
# =========================================================================
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# COACH_MODEL=claude-sonnet-4-6

# =========================================================================
# Option B — Local OpenAI-compatible server (e.g. LM Studio) for testing
# =========================================================================
# Point COACH_PROVIDER at "local" and set the base URL of your LM Studio server.
# LM Studio exposes an OpenAI-compatible API under /v1.
# COACH_PROVIDER=local
# OPENAI_BASE_URL=http://127.0.0.1:5004/v1
# OPENAI_API_KEY=lm-studio
# LOCAL_MODEL=gemma4-12b-qat-uncensored-hauhaucs-balanced
